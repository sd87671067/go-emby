# ============================================================
# go-emby 环境变量
#
# 可选配置，单文件 Compose 新装无需本文件；bind mount 旧用户保留原路径。
# 首次部署：
#
#   cp .env.example .env
#
# .env 包含密码和授权信息，请勿提交到 Git 仓库。
#
# 默认 bridge：docker compose pull && docker compose up -d
# host：将 NETWORK_MODE 改为 host，然后执行：
#   docker compose -f compose.yaml -f compose.host.yaml pull
#   docker compose -f compose.yaml -f compose.host.yaml up -d
# NETWORK_MODE 用于记录选择；host 模式必须显式指定 override 文件。
# 新版 compose 会在 go-emby 启动前自动执行一次 --prepare-schema；
# 无需新增环境变量，也无需手工进入容器升级数据库结构。
# ============================================================


# 【可选】新装留空自动生成；升级保留原 PostgreSQL 密码
#
# 建议生成：
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=


# 【可选】新装留空自动生成；旧用户保留原管理员配置
#
# 12 到 72 字节。
# 仅空数据库首次初始化时生效。
#
ADMIN_PASSWORD=


# 【可选】授权码
#
# 免费模式留空。
#
LICENSE_KEY=


# ============================================================
# 一般无需修改
# ============================================================

LICENSE_SERVER_URL=https://tl.macacaaca.top


# Docker 镜像标签
IMAGE_TAG=latest


# Web 访问端口
# bridge 模式有效；host 模式直接监听 8097。
HTTP_PORT=8097

# 默认 bridge；选择 host 时使用上面的 -f 命令。
NETWORK_MODE=bridge

# PostgreSQL 仅绑定宿主机 127.0.0.1，供 host 模式的 go-emby 使用。
POSTGRES_HOST_PORT=5433

# 宿主机媒体目录；必须事先存在，路径写错时 Docker 会直接报错。
# 例如 /vol1/1000/Emby 或 /mnt/media。容器内始终挂载为 /media。
MEDIA_PATH=./media

# go-emby 数据与备份的宿主机目录；不存在时 Docker 会自动创建。
APP_DATA_PATH=./app-data
APP_BACKUP_PATH=./app-backups
POSTGRES_DATA_PATH=./postgres-data


# go-emby 容器运行 UID/GID
#
# 默认 0:0，避免宿主机媒体目录为 root:root 755 时
# 刮削 NFO / 海报 / Still 出现 permission denied。
#
# 如需非 root 运行，例如设置 1000:1000：
#
#   PUID=1000
#   PGID=1000
#
# 请确保媒体目录、app-data 和 app-backups 对该 UID/GID 有访问权限。
# 不会自动 chown 整个媒体库。
# 即使使用 0:0 仍遇 permission denied，可检查 NFS root_squash、
# CIFS/FUSE、NAS ACL、父目录执行权限、只读挂载及 Docker 的访问权限：
#   ls -ld "$MEDIA_PATH"
#   namei -l "$MEDIA_PATH"
# 不要用 chmod -R 777 处理。
#
PUID=0
PGID=0


# ============================================================
# 可选配置
# ============================================================

# 客户端可访问的完整地址
PUBLIC_URL=

# 首次初始化 API Key
BOOTSTRAP_API_KEY=


# ============================================================
# 容器内部允许访问的媒体根目录
#
# 注意：
# 这里填写的是「容器内路径」，
# 不是 Ubuntu / NAS 本地真实路径。
#
# 宿主机主媒体目录由上面的 MEDIA_PATH 配置，例如：
# MEDIA_PATH=/vol1/1000/Emby
# MEDIA_ROOTS=/media
#
# 默认：
#
# MEDIA_ROOTS=/media
#
# 如果 compose.yaml 增加：
#
#   /movies
#   /tv
#   /anime
#
# 则改成：
#
# MEDIA_ROOTS=/media:/movies:/tv:/anime
# ============================================================

MEDIA_ROOTS=/media


# ============================================================
# Xiaoya STRM 同步 / Trakt（可选）
# ============================================================

# Xiaoya STRM 同步的源目录、目标目录、定时任务在管理后台设置。
# 以下凭据兼容旧配置；新版后台密码框保存后优先使用 dav 和已保存密码。
# 用户名默认为 dav；密码留空时尝试读取源目录 guestpass.txt。
# 若设置密码，则优先使用此密码；更换凭据后重启 go-emby。
XIAOYA_USERNAME=dav
XIAOYA_PASSWORD=

# Trakt：Go-Emby 实例唯一标识；留空则首次启动自动生成，
# 持久化于 /app/data/instance-id。请保留 APP_DATA_PATH 数据目录。
# 手动指定时须使用符合要求的 16–128 位标识，已有实例不建议更改。
GO_EMBY_INSTANCE_ID=

