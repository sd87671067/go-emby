# ============================================================
# go-emby 环境变量
#
# 首次部署：
#
#   cp .env.example .env
#
# .env 包含密码和授权信息，请勿提交到 Git 仓库。
#
# 默认 bridge：docker compose pull && docker compose up -d
# host：将 NETWORK_MODE 改为 host，然后执行：
#   docker compose -f compose.yaml -f compose.host.yaml pull
#   docker compose -f compose.yaml -f compose.host.yaml up -d
# NETWORK_MODE 用于记录选择；host 模式必须显式指定 override 文件。
# ============================================================


# 【必填】PostgreSQL 数据库密码
#
# 建议生成：
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=


# 【必填】管理员初始密码
#
# 至少 12 个字符。
# 仅空数据库首次初始化时生效。
#
ADMIN_PASSWORD=


# 【可选】授权码
#
# 免费模式留空。
#
LICENSE_KEY=


# ============================================================
# 一般无需修改
# ============================================================

LICENSE_SERVER_URL=https://tl.macacaaca.top


# Docker 镜像标签
IMAGE_TAG=latest


# Web 访问端口
# bridge 模式有效；host 模式直接监听 8097。
HTTP_PORT=8097

# 默认 bridge；选择 host 时使用上面的 -f 命令。
NETWORK_MODE=bridge

# PostgreSQL 仅绑定宿主机 127.0.0.1，供 host 模式的 go-emby 使用。
POSTGRES_HOST_PORT=5433

# 宿主机媒体目录；默认 ./media，已有媒体库请填写绝对路径。
MEDIA_PATH=./media


# go-emby 容器运行 UID/GID
#
# 默认 0:0，避免宿主机媒体目录为 root:root 755 时
# 刮削 NFO / 海报 / Still 出现 permission denied。
#
# 如需非 root 运行，请改成媒体目录实际所有者的 UID/GID，例如：
#
#   PUID=1000
#   PGID=1000
#
PUID=0
PGID=0


# ============================================================
# 可选配置
# ============================================================

# 私有 CA 证书在容器内的路径
LICENSE_CA_FILE=

# 客户端可访问的完整地址
PUBLIC_URL=

# 首次初始化 API Key
BOOTSTRAP_API_KEY=


# ============================================================
# 容器内部允许访问的媒体根目录
#
# 注意：
# 这里填写的是「容器内路径」，
# 不是 Ubuntu / NAS 本地真实路径。
#
# 宿主机主媒体目录由上面的 MEDIA_PATH 配置。
#
# 默认：
#
# MEDIA_ROOTS=/media
#
# 如果 compose.yaml 增加：
#
#   /movies
#   /tv
#   /anime
#
# 则改成：
#
# MEDIA_ROOTS=/media:/movies:/tv:/anime
# ============================================================

MEDIA_ROOTS=/media
